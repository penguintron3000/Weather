<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cityViewBackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2196F3">

        <TextView
            android:id="@+id/detailsDisplayName"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.15"
            android:textAlignment="center"
            android:gravity="center"
            android:text="City Name \n State/Province + Country Code" />

        <ScrollView
            android:id="@+id/detailsCityInfo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:fadeScrollbars="false"
            android:scrollbars="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.65"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailsMapButton">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/weatherStatusContainer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHeight_percent="0.5">

                    <TextView
                        android:id="@+id/weatherStatus"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Sunny"
                        android:textAlignment="center"
                        android:textSize="50sp"
                        android:background="@drawable/rounded_background"
                        android:layout_marginEnd="4dp"
                        android:layout_marginStart="8dp"/>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/rounded_background"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="2">

                        <TextView
                            android:id="@+id/temperatureTitle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="top"
                            android:text="Temparature"
                            android:textSize="20dp"
                            android:paddingTop="8dp"
                            android:textAlignment="center"/>

                        <TextView
                            android:id="@+id/temperature"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="40sp"
                            android:text="32°F"
                            android:textAlignment="center"/>

                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/humidityWindsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/weatherStatusContainer"
                    app:layout_constraintHeight_percent="0.45">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/rounded_background"
                        android:layout_marginEnd="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="2"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/humidityTitle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:gravity="top"
                            android:text="Humidity"
                            android:textAlignment="center"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/humidity"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="100%"
                            android:textAlignment="center"
                            android:textSize="40sp" />

                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/rounded_background"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="3">

                        <TextView
                            android:id="@+id/windsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="top"
                            android:padding="8dp"
                            android:text="Winds"
                            android:textAlignment="center"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/windsSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="40 mph"
                            android:textAlignment="center"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/windsDirection"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:padding="8dp"
                            android:text="NW"
                            android:textAlignment="textEnd"
                            android:textSize="30sp" />

                    </FrameLayout>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailsDisplayName"
            app:layout_constraintWidth_percent="0.66">

            <TextView
                android:id="@+id/detailsTime"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="00:00"
                android:textAlignment="center"
                android:textSize="40sp"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/detailsDate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:text="November 10, 2025"
                android:textAlignment="center"
                android:textSize="20sp"
                android:paddingBottom="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detailsTime" />

        </FrameLayout>

        <Button
            android:id="@+id/detailsWeatherInsightsButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:text="Weather Insights"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent=".10"
            app:layout_constraintTop_toBottomOf="@id/detailsDisplayName"
            app:layout_constraintWidth_percent="0.33" />

        <Button
            android:id="@+id/detailsMapButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:text="Show Map"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.10"
            app:layout_constraintTop_toBottomOf="@id/detailsWeatherInsightsButton"
            app:layout_constraintWidth_percent="0.33" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>